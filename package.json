{
  "name": "@honickman/ui",
  "version": "0.1.0",
  "description": "Shared component library for Honickman Companies apps",
  "type": "module",
  "main": "./dist/honickman-ui.umd.cjs",
  "module": "./dist/honickman-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/honickman-ui.js",
      "require": "./dist/honickman-ui.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./logos/*": "./logos/*"
  },
  "files": [
    "dist",
    "logos"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
